{
    log default {
        format filter {
            wrap json
            fields {
                request delete
            }
        }
    }
}

{$TTS_HOST} {
    request_body {
        max_size 128KB
    }
    @api path /api/v1/speech /ready /health /live
    handle @api {
        reverse_proxy tts:8000
    }
    handle {
        respond 404
    }
}

{$SCAN_HOST} {
    request_body {
        max_size 520MB
    }
    @status {
        method GET
        path_regexp scan_status ^/api/v1/(scans/[0-9a-fA-F-]+|artifacts/[0-9]+/scans)$
    }
    @api path /api/v1/scans /api/v1/scans/* /api/v1/artifacts/*/scans /ready /health /live
    route {
        handle @status {
            reverse_proxy scan-status:8003
        }
        handle @api {
            reverse_proxy scan:8002
        }
        handle {
            respond 404
        }
    }
}

vision.172-198-161-72.sslip.io {
    request_body {
        max_size 12MB
    }
    @api path /api/v1/references /api/v1/references/* /api/v1/recognitions /ready /health /live
    handle @api {
        reverse_proxy vision:8001
    }
    handle {
        respond 404
    }
}
