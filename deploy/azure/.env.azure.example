# Copy privately to .env.azure. Never commit the filled file.
TTS_HOST=tts.172-198-161-72.sslip.io
SCAN_HOST=scan.172-198-161-72.sslip.io
TTS_SERVICE_API_KEY=
SCAN_SERVICE_API_KEY=
# Existing PostgreSQL on BE server. Do not use localhost from the Azure container.
AI_SYSTEM_DB_HOST=
AI_SYSTEM_DB_PORT=5432
AI_SYSTEM_DB_NAME=
AI_SYSTEM_DB_USER=
AI_SYSTEM_DB_PASSWORD=
# require encrypts transport; use verify-full with the DB's trusted CA when available.
# If PostgreSQL is only reachable through a private SSH tunnel, document that tunnel
# instead of exposing port 5432 globally or silently disabling transport protection.
PGSSLMODE=require
