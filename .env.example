# Match these values to ConnectionStrings:DefaultConnection used by SMGS BE.
# When PostgreSQL runs on Windows host and the AI service runs in Docker Desktop,
# set AI_SYSTEM_DB_HOST=host.docker.internal.
AI_SYSTEM_DB_HOST=host.docker.internal
AI_SYSTEM_DB_PORT=5432
AI_SYSTEM_DB_NAME=smgs_db
AI_SYSTEM_DB_USER=postgres
AI_SYSTEM_DB_PASSWORD=replace-with-the-existing-be-db-password

# Service-to-service key for AI Vision; do not place this in Flutter or browser code.
AI_SERVICE_API_KEY=replace-with-a-long-random-secret

# Internal 3D worker key, used by the Backend gateway only.
SCAN_SERVICE_API_KEY=replace-with-a-different-long-random-secret

# Optional for local TTS compatibility. In deployment, set this on TTS and its server-side gateway.
# Never place any service key in VITE_* variables or Flutter builds.
TTS_SERVICE_API_KEY=
TTS_CACHE_MAX_BYTES=536870912
TTS_CACHE_MAX_FILES=1000
TTS_QUEUE_TIMEOUT_SECONDS=2

# Decode limits are independent of compressed upload file size.
MAX_IMAGE_PIXELS=20000000
SCAN_MAX_IMAGE_PIXELS=20000000
SCAN_MAX_METADATA_BYTES=16384

# Chat/Xuong AI: start-ai.ps1 generates this key and syncs the ignored BE key file.
AI_CHAT_SERVICE_KEY=
AI_TOUR_SERVICE_KEY=

# Root Compose host ports. Change these only if other local services occupy them.
AI_TTS_PORT=8000
AI_VISION_PORT=8001
AI_SCAN_PORT=8002
AI_CHAT_PORT=8003
AI_TOUR_PORT=8004

# Optional derived-data schemas; they do not migrate BE business tables.
AI_VISION_DB_SCHEMA=ai_vision
SCAN_DB_SCHEMA=ai_3d_scan
